# Ключ Groq — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Модель Groq, см. актуальный список: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# Необязательный код доступа — если задан, сайт будет спрашивать его при входе.
# Оставьте пустым, чтобы сайт был доступен без пароля (не рекомендуется при публичном деплое).
ACCESS_CODE=

# Необязательный системный промт — задаёт роль/тон модели для всех сообщений.
# Оставьте пустым, чтобы модель отвечала без заданной роли.
SYSTEM_PROMPT=

# Домены, которым разрешено обращаться к API из браузера (через запятую, без слеша на конце).
# Нужно, если чат встроен в приложение на другом домене. Пусто — доступ только со своей страницы.
ALLOWED_ORIGINS=http://localhost:4567,https://nutrition-tracker-73500.web.app

PORT=3000
