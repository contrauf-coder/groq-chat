# Ключ DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Модель DeepSeek, см. актуальный список: https://api-docs.deepseek.com/quick_start/pricing
DEEPSEEK_MODEL=deepseek-v4-flash

# Адрес API, обычно трогать не нужно.
DEEPSEEK_URL=https://api.deepseek.com/chat/completions

# Необязательный код доступа для клиентов с чужих доменов — они шлют его
# в заголовке x-access-code. Пусто — проверки нет.
ACCESS_CODE=

# Необязательный системный промт для запросов без поля mode.
# Оставьте пустым, чтобы модель отвечала без заданной роли.
SYSTEM_PROMPT=

# Домены, которым разрешено обращаться к API из браузера (через запятую, без слеша на конце).
ALLOWED_ORIGINS=http://localhost:4567,https://nutrition-tracker-73500.web.app

# Ключ сервис-аккаунта Firebase, JSON одной строкой. Без него напоминания не запускаются.
FIREBASE_SERVICE_ACCOUNT=

# Секрет для ручного прогона напоминаний: POST /api/reminders/run с заголовком x-reminders-secret.
REMINDERS_SECRET=

# Порт локального запуска. На Deno Deploy не используется.
PORT=3000
